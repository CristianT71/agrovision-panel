VITE_API_URL=http://localhost:3000/api
# En producción: VITE_API_URL=https://agrovision.sbs/api

# Mapa (opcionales). Son VITE_*: llegan al navegador, no pongas claves privadas.
# Por defecto: Esri World Imagery (satélite) y OpenStreetMap (calles).
# VITE_MAP_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community
# VITE_MAP_STREETS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_STREETS_ATTRIBUTION=&copy; OpenStreetMap contributors

# URL pública del webhook o Chat Trigger de n8n para el asistente de vuelos.
# Es visible en el navegador: no incluyas credenciales ni claves privadas.
# VITE_N8N_CHAT_WEBHOOK_URL=https://n8n.example.com/webhook/chat-multiespectral
